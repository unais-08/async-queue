{
  "name": "AsyncQueue",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "start": "concurrently \"npm run start:api\" \"npm run start:worker\"",
    "dev:api": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:reset": "tsx src/db/reset.db.ts"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}